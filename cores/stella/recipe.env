# Recipe for the stella core (Atari 2600).
CORE=stella
UPSTREAM_URL=https://github.com/stella-emu/stella.git
# Last upstream commit before std::format (C++20 <format>) was introduced, which gcc 12 cannot compile.
UPSTREAM_REV=75c07fb94103352dcf886c737d5dafa1a2ec942c
MAKE_DIR=src/os/libretro
LICENSE=GPL-2.0
COMMERCIAL_OK=unknown
TARGETS="linux-armhf"
