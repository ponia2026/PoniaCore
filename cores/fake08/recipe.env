# Recipe for the fake08 core (PICO-8). The libretro buildbot has no Linux build of it.
CORE=fake08
UPSTREAM_URL=https://github.com/jtothebell/fake-08.git
UPSTREAM_REV=814991a
# Directory of the libretro Makefile inside the upstream tree.
MAKE_DIR=platform/libretro
LICENSE=MIT
COMMERCIAL_OK=yes
TARGETS="linux-x86_64 linux-arm64"
