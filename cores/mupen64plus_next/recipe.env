# Recipe for the mupen64plus_next core (Nintendo 64), GLES3 build.
CORE=mupen64plus_next
UPSTREAM_URL=https://github.com/libretro/mupen64plus-libretro-nx.git
UPSTREAM_REV=15bada85906593376e8fd697f1b0b3af3a20f512
LICENSE=GPL-2.0
COMMERCIAL_OK=unknown
TARGETS="linux-arm64 linux-armhf"
# Upstream Makefile platform id for the generic AArch64 GLES 3.0 build.
MAKE_PLATFORM_linux_arm64=arm64_cortex_a53_gles3
MAKE_PLATFORM_linux_armhf=armv7neonhardfloat
