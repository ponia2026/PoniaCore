# Recipe for the ppsspp core (Sony PSP), GLES build.
CORE=ppsspp
UPSTREAM_URL=https://github.com/hrydgard/ppsspp.git
UPSTREAM_REV=6790c9ae0e70f0361b59daead370aa0fbb054640
# Directory of the libretro Makefile inside the upstream tree.
MAKE_DIR=libretro
LICENSE=GPL-2.0
COMMERCIAL_OK=unknown
TARGETS="linux-arm64"
# The Makefile enables GLES when the platform name contains "gles".
MAKE_PLATFORM_linux_arm64=arm64_gles
