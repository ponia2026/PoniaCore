# Recipe for the mupen64plus_next core (Nintendo 64), GLES3 build.
CORE=mupen64plus_next
UPSTREAM_URL=https://github.com/libretro/mupen64plus-libretro-nx.git
# Pin to an exact commit before the first release.
UPSTREAM_REV=develop
LICENSE=GPL-2.0
COMMERCIAL_OK=unknown
TARGETS="linux-arm64"
BUILD_FLAGS="FORCE_GLES3=1"
