# Recipe for the yabasanshiro core (Sega Saturn), GLES build.
CORE=yabasanshiro
UPSTREAM_URL=https://github.com/libretro/yabause.git
UPSTREAM_BRANCH=yabasanshiro
UPSTREAM_REV=09ed8e5b2e97e7a848ea2514545c34c7b809e399
# Directory of the libretro Makefile inside the upstream tree.
MAKE_DIR=yabause/src/libretro
LICENSE=GPL-2.0
COMMERCIAL_OK=unknown
TARGETS="linux-arm64 linux-armhf"
MAKE_PLATFORM_linux_arm64=arm64_cortex_a53_gles3
MAKE_PLATFORM_linux_armhf=armv7neonhardfloat
